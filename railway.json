{
  "name": "LORD XD",
  "description": "LORD XD WhatsApp Bot",
  "repository": "https://github.com/X-LORD0612/LORD-XD",
  "build": {
    "builder": "DOCKERFILE",
    "buildCommand": "npm install"
  },
  "deploy": {
    "startCommand": "node index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "variables": {
    "SESSION_ID": {
      "description": "Required: WhatsApp session token for your LORD XD bot.",
      "required": true
    },
    "REPO_URL": {
      "description": "Optional: override the bot source zip URL the loader downloads at startup",
      "required": false
    }
  }
}
